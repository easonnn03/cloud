@{
    Layout = "_Layout";
}

<title>@ViewData["Title"] View Appointment</title>

<div id="My_Appointment" class="d-flex justify-content-center" style="min-height: 60vh; align-items: flex-start; padding-top: 4rem;">
    <div class="border rounded shadow p-5 bg-white" style="max-width: 600px; width: 100%;">
        <h2 class="fw-bold mb-3 text-center">My Appointment</h2>
        <p class="text-muted text-center">Enter your Appointment ID to view your booking details.</p>

        <!-- Lookup Form -->
        <form method="post" asp-controller="Appointment" asp-action="LookupAppointment" class="mt-3">
            <div class="mb-3">
                <input type="text" name="AppointmentId" class="form-control" placeholder="Enter your Appointment ID" required />
            </div>
            <div class="d-flex justify-content-center">
                <button type="submit" class="btn btn-primary px-4">Search</button>
            </div>
        </form>

        <!-- Success Result -->
        @if (ViewBag.Appointment != null)
        {
            var appointment = ViewBag.Appointment;
            <div class="mt-4 border rounded shadow-sm p-4 bg-light">
                <h5 class="fw-bold">Appointment Details</h5>
                <p><strong>Name:</strong> @appointment.FullName</p>
                <p><strong>Email:</strong> @appointment.Email</p>
                <p><strong>Phone:</strong> @appointment.PhoneNumber</p>
                <p><strong>Service:</strong> @appointment.Service</p>
                <p><strong>Date & Time:</strong> @appointment.StartTime.ToString("f")</p>
                <p><strong>Status:</strong> @appointment.Status</p>
            </div>
        }
        <!-- Not Found -->
        else if (ViewBag.NotFound == true)
        {
        <div class="mt-4 border border-danger rounded shadow-sm p-4 bg-white">
            <h5 class="fw-bold text-danger mb-2">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>Appointment Not Found
            </h5>
            <p class="mb-0 text-muted">Please check your Appointment ID and try again.</p>
        </div>
        }
    </div>
</div>
