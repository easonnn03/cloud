@model cloudass.Models.AppointmentDetailsViewModel
@{
    ViewData["Title"] = "Appointment Information";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white rounded-top-4">
                    <h3 class="mb-0 text-center">Appointment Details</h3>
                </div>

                <div class="card-body p-4">

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Appointment ID:</div>
                        <div class="col-sm-8">@Model.Id</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Status:</div>
                        <div class="col-sm-8">@Model.status</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Booked At:</div>
                        <div class="col-sm-8">@Model.CreatedTime.ToString("f")</div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Patient Name:</div>
                        <div class="col-sm-8">@Model.PatientName</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Phone Number:</div>
                        <div class="col-sm-8">@Model.PatientPhone</div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Service:</div>
                        <div class="col-sm-8">@Model.DentistService</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Appointment Date:</div>
                        <div class="col-sm-8">@Model.AppointmentDate.ToString("f")</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Duration:</div>
                        <div class="col-sm-8">@Model.Duration.TotalMinutes.ToString() mins</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Notes:</div>
                        <div class="col-sm-8">@Model.PatientNotes</div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<div class="d-flex justify-content-between mt-4">
    <!-- Back Button -->
    <a href="@Url.Action("SearchAppointment", "Appointment")" class="btn btn-outline-secondary rounded-pill px-4">
        ← Back
    </a>


    @if (Model.status == "Scheduled")
    {
        <!-- Delete Button (POST via form for safety) -->
        <form asp-action="DeleteAppointment" method="post" onsubmit="return confirm('Are you sure you want to delete this appointment?');">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="button" class="btn btn-danger rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#deleteModal">
                🗑 Delete Appointment
            </button>
        </form>

        <!-- Delete Confirmation Modal -->
        <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 shadow">

                    <div class="modal-header bg-danger text-white rounded-top-4">
                        <h5 class="modal-title" id="deleteModalLabel">Confirm Deletion</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body text-center">
                        <p>Are you sure you want to delete this appointment?</p>
                        <p class="text-muted">This action cannot be undo.</p>
                    </div>

                    <div class="modal-footer justify-content-between px-4 pb-4">
                        <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>

                        <form asp-action="DeleteAppointment" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-danger rounded-pill px-4">
                                Yes, Delete
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    }
</div>

