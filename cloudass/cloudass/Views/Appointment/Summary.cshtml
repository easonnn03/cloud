@{
    Layout = "_Layout";
    ViewData["Title"] = "Appointment Summary";
}

<div class="d-flex justify-content-center" style="min-height: 100vh; align-items: flex-start; padding-top: 4rem;">
    <div class="border rounded shadow p-5 bg-white" style="max-width: 600px; width: 100%;">
        <h2 class="fw-bold mb-4 text-center">Appointment Summary</h2>

        <div class="card border-0">
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <strong>Full Name:</strong> @TempData["Full Name"]
                    </li>
                    <li class="list-group-item">
                        <strong>Email:</strong> @TempData["Email"]
                    </li>
                    <li class="list-group-item">
                        <strong>Phone Number:</strong> @TempData["Phone Number"]
                    </li>
                    <li class="list-group-item">
                        <strong>Service:</strong> @TempData["Selected Service"]
                    </li>
                    <li class="list-group-item">
                        <strong>Date & Time:</strong>
                        @{
                            var dt = TempData["Selected Time"]?.ToString();
                            var parsed = !string.IsNullOrEmpty(dt) ? DateTime.Parse(dt) : DateTime.MinValue;
                        }
                        @parsed.ToString("dddd, dd MMMM yyyy - hh:mm tt")
                    </li>
                </ul>
            </div>
        </div>

        <div class="text-center mt-4">
            <a href="/Appointment/Appointment3" class="btn btn-outline-secondary me-2">Back</a>
            <a href="/Home/MakeAppointment" class="btn btn-primary">Submit</a>
        </div>
    </div>
</div>