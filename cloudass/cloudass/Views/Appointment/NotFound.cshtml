@{
    ViewData["Title"] = "Appointment Not Found";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-5">

                    <div class="mb-4">
                        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 3rem;"></i>
                    </div>

                    <h2 class="text-danger mb-3">Appointment Not Found</h2>

                    <p class="text-muted mb-4">
                        The appointment you're trying to view does not exist or may have been removed.
                        Please check your Appointment ID and try again.
                    </p>

                    <a href="@Url.Action("SearchAppointment", "Appointment")" class="btn btn-outline-primary btn-lg rounded-pill px-4">
                        Back to Search
                    </a>

                </div>
            </div>

        </div>
    </div>
</div>
