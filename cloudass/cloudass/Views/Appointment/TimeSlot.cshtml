@model cloudass.Models.TimeSlotViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Make Appointment";
}

<title>@ViewData["Title"] Make Appointment</title>

<div class="d-flex justify-content-center" style="min-height: 100vh; align-items: flex-start; padding-top: 4rem;">
    <div class="border rounded shadow p-5 bg-white" style="max-width: 800px; width: 100%;">
        <h2 class="fw-bold mb-4 text-center">Step 3: Select Time Slot</h2>

        <form method="post" asp-controller="Appointment" asp-action="TimeSlot">
            <div class="mb-3">
                <label for="selectedMonth" class="form-label">Select Month</label>
                <select class="form-select" id="selectedMonth">
                    @for (int i = 0; i < 6; i++)
                    {
                        var month = DateTime.Now.AddMonths(i);
                        <option value="@month.ToString("yyyy-MM")">@month.ToString("MMMM yyyy")</option>
                    }
                </select>
            </div>

            <div id="daySlotContainer">
                <!-- JS will load available days and slots here -->
            </div>

            <div class="mt-4 d-flex justify-content-center gap-3 flex-wrap">
                <a href="/Appointment/Appointment2" class="btn btn-dark">Back</a>
                <button type="submit" class="btn btn-primary" id="confirmBtn" disabled>Confirm</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        /* -----------------------------  data ------------------------------ */
        const slotsNeeded = @Model.slot_needed;                   // e.g. 3 blocks
        const bookedSlots = @Html.Raw(ViewBag.BookedSlots ?? "[]"); // real JS array

        /* business hours */
        const HOURS = { open: 9, close: 17, lunchStart: 12, lunchEnd: 13, step: 30 };

        const monthSel   = document.getElementById("selectedMonth");
        const slotWrap   = document.getElementById("daySlotContainer");
        const confirmBtn = document.getElementById("confirmBtn");

        monthSel.addEventListener("change", drawCalendar);
        window.addEventListener("load",       drawCalendar);

        /* --------------------------  draw the grid ------------------------- */
        function drawCalendar() {
            slotWrap.innerHTML = "";
            const start = new Date(monthSel.value + "-01");
            const end   = new Date(start.getFullYear(), start.getMonth()+1, 0);
            const today    = new Date();          // now
            today.setHours(0, 0, 0, 0);           // → 00:00 today
            
            for (let d = new Date(start); d <= end; d.setDate(d.getDate()+1)) {

                if (d < today) continue;
                
                if (d.getDay() === 0 || d.getDay() === 6) continue;       // skip weekend

                const year  = d.getFullYear();     // 2025
                const month = String(d.getMonth() + 1).padStart(2, '0'); // 04
                const day   = String(d.getDate()).padStart(2, '0');      // 22
                const dayISO = `${year}-${month}-${day}`;  // yyyy-MM-dd manually

                let html = `<div class="mb-3">
                              <label class="fw-semibold">${d.toDateString()}</label>
                              <div class="d-flex flex-wrap gap-2">`;

                for (let h = HOURS.open; h < HOURS.close; h++) {
                    if (h === HOURS.lunchStart) continue;
                    for (let m = 0; m < 60; m += HOURS.step) {
                        const time = `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}`;
                        const stamp = `${dayISO} ${time}`;
                        const id    = `slot-${stamp.replace(/[:\s]/g,'')}`;
                        const taken = bookedSlots.includes(stamp);

                        html += taken
                                ? `<input class="btn-check"  type="radio" id="${id}" disabled>
                                   <label  class="btn btn-outline-secondary disabled"
                                           for="${id}" style="background:#ccc;color:#666">${time}</label>`
                                : `<input class="btn-check"  type="radio" id="${id}"
                                           name="start_time" value="${stamp}">
                                   <label  class="btn btn-outline-secondary" for="${id}">${time}</label>`;
                    }
                }
                html += `</div></div>`;
                slotWrap.insertAdjacentHTML("beforeend", html);
            }

            attachHandlers();                // listeners must be re‑wired every redraw
        }

        /* -----------------  pick N consecutive blocks at once -------------- */
        function attachHandlers() {
            confirmBtn.disabled = true;
            const radios = [...document.querySelectorAll('input[name="start_time"]')];

            radios.forEach((r, idx) => r.addEventListener("change", () => {
                /* ----- clear previous state ----- */
                document.querySelectorAll('.selected-following')
                        .forEach(lbl => lbl.classList.remove('selected-following'));
                radios.forEach(x => x.checked = false);

                /* ----- build the new chain (same day only) ----- */
                const selected = [];
                const firstDate = r.value.split(" ")[0];          // yyyy‑MM‑dd

                for (let i = 0; i < slotsNeeded; i++) {
                    const next = radios[idx + i];
                    if (!next) break;                             // ran out of radios
                    if (next.disabled) break;                     // slot taken
                    if (next.value.split(" ")[0] !== firstDate) break; // next day – stop
                    selected.push(next);
                }

                /* check at least one slot selected (always true) */
                if (selected.length) {
                    selected[0].checked = true; // only first posts
                    selected.forEach(n => {
                        const lbl = document.querySelector(`label[for="${n.id}"]`);
                        lbl?.classList.add('selected-following');
                    });
                    confirmBtn.disabled = false;
                }
            }));
        }


        /* --------------------------  cosmetic CSS -------------------------- */
        const style = document.createElement('style');
        style.textContent = `
            .selected-following.btn-outline-secondary {
                background:#0d6efd !important;   /* same blue as .btn-primary */
                color:#fff !important;
                border-color:#0d6efd !important;
            }`;
        document.head.appendChild(style);
    </script>
}