
@{
    Layout = "_Layout";
}

<title>@ViewData["Title"] Make Appointment</title>

<div class="d-flex justify-content-center" style="min-height: 100vh; align-items: flex-start; padding-top: 4rem;">
    <div class="border rounded shadow p-5 bg-white" style="max-width: 800px; width: 100%;">
        <h2 class="fw-bold mb-4 text-center">Step 3: Select Time Slot</h2>

        <form method="post" asp-action="Summary">
            <div class="mb-3">
                <label for="selectedMonth" class="form-label">Select Month</label>
                <select class="form-select" id="selectedMonth">
                    @for (int i = 0; i < 6; i++)
                    {
                        var month = DateTime.Now.AddMonths(i);
                        <option value="@month.ToString("yyyy-MM")">@month.ToString("MMMM yyyy")</option>
                    }
                </select>
            </div>

            <div id="daySlotContainer">
                <!-- JS will load available days and slots here -->
            </div>

            <div class="mt-4 d-flex justify-content-center gap-3 flex-wrap">
                <a href="/Appointment/Appointment2" class="btn btn-dark">Back</a>
                <button type="submit" class="btn btn-primary" id="confirmBtn" disabled>Confirm</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const slotsNeeded = @ViewBag.SlotsNeeded ?? 1;
        const bookedSlots = @Html.Raw(ViewBag.BookedSlots ?? "[]");
        const allTimeInputs = [];

        const operatingHours = {
            start: 9,
            end: 17,
            lunchStart: 12,
            lunchEnd: 13,
            interval: 30
        };

        const container = document.getElementById("daySlotContainer");
        const monthDropdown = document.getElementById("selectedMonth");
        const confirmBtn = document.getElementById("confirmBtn");

        monthDropdown.addEventListener("change", generateSlots);
        window.addEventListener("load", generateSlots);

        function generateSlots() {
            const selectedMonth = monthDropdown.value;
            const startDate = new Date(selectedMonth + "-01");
            const endDate = new Date(startDate.getFullYear(), startDate.getMonth() + 1, 0);

            container.innerHTML = "";

            for (let d = new Date(startDate); d <= endDate; d.setDate(d.getDate() + 1)) {
                const day = new Date(d);
                const dayOfWeek = day.getDay();
                if (dayOfWeek === 0 || dayOfWeek === 6) continue; // Skip Sat/Sun

                const dayStr = day.toISOString().split('T')[0];

                let section = `<div class="mb-3">
                    <label class="fw-semibold">${day.toDateString()}</label>
                    <div class="d-flex flex-wrap gap-2">`;

                for (let hour = operatingHours.start; hour < operatingHours.end; hour++) {
                    for (let minute = 0; minute < 60; minute += operatingHours.interval) {
                    if (hour === operatingHours.lunchStart) continue;

                        const time = `${hour.toString().padStart(2, '0')}:${minute.toString().padStart(2, '0')}`;
                        const value = `${dayStr} ${time}`;
                        const id = `slot-${dayStr}-${time.replace(":", "")}`;
                        const isBooked = bookedSlots.includes(value);

                        if (isBooked) {
                            section += `
                                <input type="radio" disabled class="btn-check" id="${id}" name="SelectedTime" value="${value}">
                                <label class="btn btn-outline-secondary disabled" for="${id}" style="background-color: #ccc; color: #666;">${time}</label>
                            `;
                        } else {
                            section += `
                                <input type="radio" class="btn-check" id="${id}" name="SelectedTime" value="${value}" data-index="${allTimeInputs.length}">
                                <label class="btn btn-outline-secondary" for="${id}">${time}</label>
                            `;
                            allTimeInputs.push({ id, value });
                        }
                    }
                }

                section += "</div></div>";
                container.innerHTML += section;
            }

            document.querySelectorAll('input[name="SelectedTime"]').forEach(btn => {
                btn.addEventListener("change", () => {
                    confirmBtn.disabled = false;
                });
            });
        }

        setTimeout(() => {
            const radios = document.querySelectorAll('input[name="SelectedTime"]');

            radios.forEach((radio, index) => {
                radio.addEventListener("change", () => {
                    // Deselect all first
                    radios.forEach(r => r.checked = false);
                                
                    // Remove all previous highlights
                    document.querySelectorAll('.btn-outline-secondary').forEach(label => {
                        label.classList.remove('selected-following');
                    });

                    // Check if enough slots are available
                    for (let i = 0; i < slotsNeeded; i++) {
                        const target = radios[index + i];

                        // ❗ Error handling: not enough space or slot is taken
                        if (!target || target.disabled) {
                            alert("Not enough available time slots after this one.");
                            return;
                        }
                    }

                    // Check selected + highlight others
                    for (let i = 0; i < slotsNeeded; i++) {
                        const target = radios[index + i];
                        if (target && !target.disabled) {
                            if (i === 0) {
                                target.checked = true;
                            }

                            // Highlight related label
                            const label = document.querySelector(`label[for="${target.id}"]`);
                            if (label) {
                                label.classList.add('selected-following');
                            }
                        }
                    }

                    confirmBtn.disabled = false;
                });
            });
        }, 10);
    </script>
}