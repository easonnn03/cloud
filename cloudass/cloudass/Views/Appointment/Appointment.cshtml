@model cloudass.Models.Appointment
@{
    Layout = "_Layout";

}

<title>@ViewData["Title"] Make Appointment</title>

<div id="Apppointment" class="d-flex justify-content-center" style="min-height: 100vh; align-items: flex-start; padding-bottom: 3rem;">
    <div class="border rounded shadow p-5 bg-white" style="max-width: 500px; width: 100%;">
        <h2 class="fw-bold mb-4 text-center">Step 1: Please enter your information</h2>

        <form id="step1Form" asp-action="Appointment2">
            <div class="mb-3">
                <label asp-for="FullName" class="form-label">Full Name</label>
                <input asp-for="FullName" class="form-control" placeholder="Enter your full name" required />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="Enter your email address" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="e.g., 0123456789" pattern="^\d{10,11}$" required />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <div class="mt-4 d-flex justify-content-center gap-3 flex-wrap">
                <a href="/Home/Index/#Our_Service" class="btn btn-dark px-3">Back</a>
                <button type="submit" class="btn btn-primary" id="nextBtn" disabled>Next</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const form = document.getElementById("step1Form");
        const nextBtn = document.getElementById("nextBtn");

        const validate = () => {
            if (form.checkValidity()) {
                nextBtn.disabled = false;
            } else {
                nextBtn.disabled = true;
            }
        };

        // Re-validate whenever the user types or changes something
        form.addEventListener("input", validate);
        form.addEventListener("blur", validate, true);  // capture blur events
    </script>
}