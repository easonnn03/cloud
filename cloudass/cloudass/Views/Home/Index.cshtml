@model IEnumerable<cloudass.Models.DbTable.AppointmentServiceModel>

<title>@ViewData["Title"] DenTeeth</title>

<div class="hero-image text-white text-center d-flex align-items-center justify-content-center">
    <div class="hero-text">
        <h1 class="display-4 fw-bold">Welcome to DenTeeth</h1>
        <p class="lead">Caring for your smile, one appointment at a time</p>
    </div>
</div>

<div class="row text-center my-5">
    <!-- Our Service -->
    <div class="col-md-6 mb-4">
        <a href="#Our_Service" class="text-decoration-none">
            <div class="image-card position-relative overflow-hidden rounded">
                <img src="/images/Our_Services.jpeg" class="w-100 h-100 object-fit-cover" alt="Our Service">
                <div class="image-overlay d-flex align-items-center justify-content-center">
                    <h3 class="text-white fw-bold">Our Service</h3>
                </div>
            </div>
        </a>
    </div>

    <!-- My Appointment -->
    <div class="col-md-6 mb-4">
        <a href="/Admin/View_Appointment" class="text-decoration-none">
            <div class="image-card position-relative overflow-hidden rounded">
                <img src="/images/My_Appointment.jpg" class="w-100 h-100 object-fit-cover" alt="My Appointment">
                <div class="image-overlay d-flex align-items-center justify-content-center">
                    <h3 class="text-white fw-bold">My Appointment</h3>
                </div>
            </div>
        </a>
    </div>
</div>

<div id="Our_Service" class="container my-5">
    <h2 class="fw-bold">Our Service</h2>

    <div class="list-group">
        <!-- Card 1 -->
        @foreach (var service in Model)
        {

            var isDisabled = !service.IsActive;

            string imageFile = "";
            string Description = "";

            switch (service.ServiceName)
            {
                case "Teeth Cleaning":
                    imageFile = "Teeth_Cleaning.jpg";
                    Description = "Professional tooth cleaning for oral hygiene.";
                    break;
                case "Teeth Bracing":
                    imageFile = "Braces.jpg";
                    Description = "Braces to correct teeth alignment.";
                    break;
                case "Dental Fillings":
                    imageFile = "Teeth_Filling.jpg";
                    Description = "Repair decayed or damaged teeth.";
                    break;
                case "Tooth Extraction":
                    imageFile = "Tooth_Extraction.jpg";
                    Description = "Safe tooth removal by professionals.";
                    break;
            }


            <div class="list-group-item py-4 @(isDisabled ? "disabled-card" : "")">
                <div class="row g-3 align-items-center">
                    <div class="col-md-2 text-center">
                        <img src="/images/@imageFile" class="img-fluid rounded @(isDisabled ? "opacity-50" : "")" alt="@service.ServiceName">
                    </div>
                    <div class="col-md-10">
                        <h5 class="fw-bold">@service.ServiceName</h5>
                        <p class="mb-2 text-muted">@Description</p>
                        @if (!isDisabled)
                        {
                            <a href="/Services/@service.ServiceName.Replace(" ", "_")" class="btn btn-outline-dark">More Info...</a>
                        }
                        else
                        {
                            <button class="btn btn-secondary" disabled>Unavailable</button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>


