@*Defines common structure for all pages*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
</head>
    <body>

        <!-- Navbar -->
        <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
            <div class="container d-flex justify-content-between align-items-center flex-wrap">

                <div class="d-flex align-items-center gap-4">
                    <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/">
                        <img src="~/images/logo.png" alt="Logo" width="30" height="30" />
                        DenTeeth
                    </a>

                    <ul class="navbar-nav flex-row gap-3 mb-0">
                        <li class="nav-item"><a class="nav-link" href="#">Our Service</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">My Appointmnet</a></li>

                    </ul>
                </div>
            </div>
        </nav>

    <!-- Body Content -->
    @if (ViewData["FullWidthLayout"] as bool? == true)
    {
        <main role="main">
            @RenderBody()
        </main>
    }
    else
    {
        <main role="main" class="container py-5">
            @RenderBody()
        </main>
    }

    @RenderSection("Scripts", required: false)

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    </body>
</html>
