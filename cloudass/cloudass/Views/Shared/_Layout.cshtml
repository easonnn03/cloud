<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
        <div class="container d-flex justify-content-between align-items-center flex-wrap">
           
            <div class="d-flex align-items-center gap-4">
                <a class="navbar-brand fw-bold" href="#">🦷 DenTeeth</a>

                <ul class="navbar-nav flex-row gap-3 mb-0">
                    <li class="nav-item"><a class="nav-link" href="/Home/Index/#Our_Service">Our Service</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Appointment/View_Appointment">My Appointmnet</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Body Content -->
    @if (ViewData["FullWidthLayout"] as bool? == true)
    {
        <main role="main">
            @RenderBody()
        </main>
    }
    else
    {
        <main role="main" class="container py-5">
            @RenderBody()
        </main>
    }

    @RenderSection("Scripts", required: false)

</body>
</html>